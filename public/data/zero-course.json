        "vi": "Chào buổi sáng!"
      },
      {
        "en": "Goodbye!",
        "vi": "Tạm biệt!"
      },
      {
        "en": "Thank you!",
        "vi": "Cảm ơn bạn!"
      },
      {
        "en": "You are welcome.",
        "vi": "Không có gì."
      }
